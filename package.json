{
  "name": "multi-LLM-at-once",
  "version": "0.3.0",
  "description": "Ask several LLMs the same question at once — local Ollama models; the OpenAI, Anthropic, Gemini, Grok, Groq, Mistral and DeepSeek APIs; hundreds more through OpenRouter — and compare their answers side by side.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ido",
    "email": "https://ido-green.appspot.com/contact.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenido/multi-LLM-at-once.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "PORT=3000 node --watch server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ollama": "^0.6.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
